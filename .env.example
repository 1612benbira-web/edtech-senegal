# Supabase — clés publiques (utilisées côté client)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — clé service role (JAMAIS exposée au client, server actions uniquement)
SUPABASE_SERVICE_ROLE_KEY=

# ID projet Supabase (pour la génération de types)
SUPABASE_PROJECT_ID=

# URL publique du site (utilisée pour les redirections d'auth, ex: reset password)
# En production, doit être l'URL réelle déployée (ex: https://edtech-senegal.vercel.app)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Fuseau horaire par défaut de l'application
DEFAULT_TIMEZONE=Africa/Dakar
